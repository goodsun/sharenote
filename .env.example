# 共有手帳(shareNOTE）環境設定テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# 注意：一部の変数はセキュリティ上、GitHub Secretsのみで管理します（.envには記載しません）
# GitHub Actions Secretsにも同じ変数名で設定してください
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY

# ====================
# AWS Configuration
# ====================

CDK_ACCOUNT_DEV=your-dev-aws-account-id
CDK_ACCOUNT_STG=your-stg-aws-account-id
CDK_ACCOUNT_PROD=your-prod-aws-account-id
CDK_REGION=ap-northeast-1

# ====================
# Domain Configuration
# ====================

DOMAIN_DEV=localhost:8080
DOMAIN_STG=your-stg-domain.com
DOMAIN_PROD=your-prod-domain.com

# ====================
# Security Configuration
# ====================
# データベース暗号化用のキー（32文字以上のランダムな文字列を設定）
# 例: openssl rand -base64 32
# 重要: 環境ごとに異なるキーを設定してください
ENCRYPTION_KEY_DEV=your-dev-encryption-key-here
ENCRYPTION_KEY_STG=your-stg-encryption-key-here
ENCRYPTION_KEY_PROD=your-prod-encryption-key-here

# ====================
# Google OAuth Configuration
# ====================
# Google Cloud ConsoleでOAuth 2.0クライアントIDを作成
# https://console.cloud.google.com/

GOOGLE_CLIENT_ID_DEV=your-dev-google-client-id
GOOGLE_CLIENT_ID_STG=your-stg-google-client-id
GOOGLE_CLIENT_ID_PROD=your-prod-google-client-id

# ====================
# Alexa Skills Configuration
# ====================
# Alexa開発者アカウントの認証情報（全環境共通）
# ASK CLIで `ask configure` を実行して取得
# 重要: 長いトークンは必ず引用符で囲む
ALEXA_ACCESS_TOKEN="Atza|IwEBI..."  # 約1000文字の長いトークン
ALEXA_REFRESH_TOKEN="Atzr|IwEBI..." # 約1000文字の長いトークン

ALEXA_SKILL_ID_DEV=your-dev-alexa-skill-id
ALEXA_SKILL_ID_STG=your-stg-alexa-skill-id
ALEXA_SKILL_ID_PROD=your-prod-alexa-skill-id

ALEXA_VENDOR_ID=M1234567890         # 引用符不要（短い）

# ====================
# 使用方法
# ====================
# 1. このファイルをコピーして .env を作成
#    cp .env.example .env
#
# 2. 各環境のAWSアカウントIDを設定
#
# 3. Google Cloud ConsoleでOAuth 2.0クライアントIDを作成し設定
#    - 承認済みのJavaScript生成元に環境別URLを追加
#    - 開発: http://localhost:8080
#    - S3: http://sharenote-{env}-frontend.s3-website-ap-northeast-1.amazonaws.com
#    - 本番: https://your-domain.com
#
# 4. ビルド時に環境を指定
#    npm run build:frontend:dev   # CDK_ENV=dev で実行
#    npm run build:frontend:stg   # CDK_ENV=stg で実行
#    npm run build:frontend:prod  # CDK_ENV=prod で実行
#
# 5. デプロイ (環境変数 CDK_ENV を設定してから実行)
#    export CDK_ENV=dev
#    cdk deploy sharenote-${CDK_ENV}
#
# ====================
# GitHub Actions での使用
# ====================
# リポジトリの Settings > Secrets and variables > Actions で
# 以下の変数を設定してください：
#
# 【GitHub Secretsのみで管理する変数】（.envには記載しない）
# - AWS_ACCESS_KEY_ID (AWSアクセスキー) ※セキュリティ上、ローカルに保存しない
# - AWS_SECRET_ACCESS_KEY (AWSシークレットキー) ※セキュリティ上、ローカルに保存しない
# - CDK_ACCOUNT (現在の環境に応じてCDK_ACCOUNT_DEV/STG/PRODから選択される)
#
# 【.envファイルと同じ値を設定する変数】
# AWS環境設定
# - CDK_REGION
# - CDK_ACCOUNT_DEV
# - CDK_ACCOUNT_STG
# - CDK_ACCOUNT_PROD
#
# Google OAuth関連
# - GOOGLE_CLIENT_ID_DEV
# - GOOGLE_CLIENT_ID_STG
# - GOOGLE_CLIENT_ID_PROD
#
# Alexa Skills関連（全環境共通）
# - ALEXA_ACCESS_TOKEN
# - ALEXA_REFRESH_TOKEN
# - ALEXA_VENDOR_ID
#
# Alexa Skills関連（環境別）
# - ALEXA_SKILL_ID_DEV
# - ALEXA_SKILL_ID_STG
# - ALEXA_SKILL_ID_PROD
#
# ドメイン関連
# - DOMAIN_DEV
# - DOMAIN_STG
# - DOMAIN_PROD
#
# セキュリティ関連
# - ENCRYPTION_KEY_DEV
# - ENCRYPTION_KEY_STG
# - ENCRYPTION_KEY_PROD
#
# ====================
# 重要な注意事項
# ====================
# - .env ファイルは .gitignore に含まれています（Gitにコミットされません）
# - 本番環境の認証情報は特に慎重に管理してください
# - このテンプレートファイルには実際の値を入れないでください
#
# 【ローカル開発時のAWS認証について】
# AWS_ACCESS_KEY_ID と AWS_SECRET_ACCESS_KEY は .env ファイルには記載しません。
# 代わりに以下のいずれかの方法で設定してください：
# 1. AWS CLI設定: aws configure
# 2. 環境変数: export AWS_ACCESS_KEY_ID=xxx
# 3. ~/.aws/credentials ファイル
#
# これによりセキュリティリスクを最小限に抑えます。